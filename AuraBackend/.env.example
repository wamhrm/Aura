# Copy to .env for local runs. Never commit .env, production values live in Render.

# Server
PORT=8080

# Database. "db" is the Postgres service from docker-compose.yml.
POSTGRESQL_HOST=db
POSTGRESQL_PORT=5432
POSTGRESQL_USER=aura
POSTGRESQL_PASSWORD=aura
POSTGRESQL_DBNAME=aura
# Path to the CA certificate of the database. Without it the connection runs WITHOUT TLS.
POSTGRESQL_CA_CERT_PATH=

# OpenAI
OPENAI_KEY=
# OPENAI_BASE_URL=https://api.openai.com

# Email for password reset
RESEND_API_KEY=
# RESEND_BASE_URL=https://api.resend.com
# RESEND_FROM=Aura <noreply@aurawamhrm.space>

# Sign in with Apple. Without APPLE_BUNDLE_ID the sign-in returns 503.
# Without the other three the Apple token is not revoked when an account is deleted.
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key, line breaks written as \n.
APPLE_PRIVATE_KEY=
# APPLE_AUTH_BASE_URL=https://appleid.apple.com
