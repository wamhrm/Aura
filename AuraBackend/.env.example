# Copy to .env for local runs. Never commit .env, production values live in Render.

# Server
PORT=8080

# Database. "db" is the Postgres service from docker-compose.yml.
POSTGRESQL_HOST=db
POSTGRESQL_PORT=5432
POSTGRESQL_USER=aura
POSTGRESQL_PASSWORD=aura
POSTGRESQL_DBNAME=aura
# Production requires a readable, valid CA certificate and verifies the database hostname.
# An empty path disables TLS only for development/testing, such as the local Compose database.
POSTGRESQL_CA_CERT_PATH=

# OpenAI
OPENAI_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-5.4

# Email for password reset and email confirmation
RESEND_API_KEY=
# RESEND_BASE_URL=https://api.resend.com
# RESEND_FROM=Aura <noreply@aurawamhrm.space>

# Oldest app version the API accepts. Unset means every version is allowed.
# MIN_APP_VERSION=1.0
